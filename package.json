{
  "name": "healthcare-motion-banner",
  "version": "1.0.0",
  "private": true,
  "description": "Healthcare. Delivered. — deterministic Remotion motion banner (1280x540, 30fps, 6s seamless loop)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "placeholders": "node scripts/make-placeholders.mjs",
    "render:mp4": "remotion render src/index.ts HealthcareBanner output/healthcare-banner.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:webm": "remotion render src/index.ts HealthcareBanner output/healthcare-banner.webm --codec=vp9 --crf=24",
    "render": "npm run render:mp4 && npm run render:webm",
    "verify:loop": "node scripts/verify-loop.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "^4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.530"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.530",
    "@remotion/renderer": "^4.0.530",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
